# Always revalidate the HTML so a fresh deploy shows on the next load
# (no-cache = the browser may store it but must revalidate via ETag first).
# Other assets (images, video, fonts) keep normal caching.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/privacy
  Cache-Control: no-cache
/grading
  Cache-Control: no-cache
/paper
  Cache-Control: no-cache
/agent-safety
  Cache-Control: no-cache
